{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "直播稿助手",
  "version": "0.1.0",
  "identifier": "com.codex.live-script",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "直播稿助手",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../aliyun_auto_pipeline.py", "../local_live_script_tool.py", "../live_script_tool.py"]
  }
}
